# ============================================================
# LLM 配置（OpenAI 兼容接口：DeepSeek / 通义千问 / OpenAI）
# 复制为 .env.local 后填入真实值；.env.local 已被 .gitignore 忽略
# ============================================================

# DeepSeek 示例
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat

# 通义千问示例（DashScope OpenAI 兼容模式）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# OpenAI 示例
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# LLM 调用失败时是否使用规则匹配兜底（默认 true）
LLM_FALLBACK_ENABLED=true

# 商品目录数据源：real（真实电商数据快照，默认）| mock（内置 50 条演示数据）
# real 的数据来自 data/real-catalog.json，可用 npm run catalog:build 重新生成
CATALOG_SOURCE=real

# 短期记忆：把最近若干轮对话注入意图解析，用于消解「刚才那个」「换成第二件」这类指代。
# 历史只用于理解指代，不作为路由依据；裁剪以「轮次」为单位，不截断单条消息。
HISTORY_ENABLED=true
# 字符预算（约 2 字符 ≈ 1 token），超出则丢弃最旧的完整轮次
HISTORY_MAX_CHARS=2000

# ============================================================
# JustOneAPI 实时商品数据源（可选，不配置则所有现有功能不受影响）
# ============================================================
# 从 https://dashboard.justoneapi.com 获取 token；这里只写占位符，绝不提交真值。
# 仅服务端读取，禁止写成 NEXT_PUBLIC_JUSTONEAPI_TOKEN（那会进客户端 bundle）。
# 配置后：图里会多一个「条件触发的实时数据补充」节点（只在用户问到实时性时才拉取）。
JUSTONEAPI_TOKEN=

# ============================================================
# 会话持久化（checkpointer）
# ============================================================
# sqlite（默认）：落盘到本地文件，进程重启后同一会话仍能恢复上下文
# memory：纯内存，进程重启即丢；sqlite 初始化失败时也会自动回落到这里
CHECKPOINT_BACKEND=sqlite
# 落盘位置（已在 .gitignore 中忽略；该文件包含完整对话内容，不要放进 public/）
CHECKPOINT_DB_PATH=.cache/checkpoints.sqlite
# 超过该天数未活跃的会话会被清理（在新会话创建时惰性触发）
SESSION_TTL_DAYS=7
